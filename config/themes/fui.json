{
  "name": "FUI",
  "desc": "Fictional-UI instrument panel: hairlines, square corners, monospace uppercase labels, corner brackets.",
  "font": {"ui": "plex-mono", "mono": "plex-mono", "size": 12, "size_small": 11, "size_title": 13},
  "color": {
    "bg": "#06080a", "surface1": "#0b0f12", "surface2": "#0e1417", "surface3": "#12191d", "raised": "#163034",
    "border": "#1d3a3e", "text": "#cfe9e6", "text2": "#7fa5a1", "text3": "#557370",
    "accent": "#43e6d3", "on_accent": "#031412", "good": "#5fd38a", "warn": "#f2b84b", "bad": "#f25a50"
