; Engine configuration file.

config_version=5

[application]

config/name="code-scrap"
config/description="Zoomable map of a codebase — GDScript viewer"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://scripts/core/settings.gd"
Keymap="*res://scripts/core/keymap.gd"
Style="*res://scripts/core/style.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/energy_saving/keep_screen_on=false

[gui]

theme/default_font_antialiasing=1

[shader_globals]

scrap_glyph_from={
"type": "float",
"value": 4.0
}
scrap_glyph_full={
"type": "float",
"value": 8.0
}
scrap_text_weight={
"type": "float",
"value": 0.75
}
scrap_line_px={
"type": "float",
"value": 1.0
}
scrap_line_min_box={
"type": "float",
"value": 6.0
}
scrap_depth_tone={
"type": "float",
"value": 0.3
}
scrap_scope_opacity={
"type": "float",
"value": 0.55
}
scrap_scope_radius={
"type": "float",
"value": 4.0
}
scrap_scope_dash={
"type": "float",
"value": 1.0
}
scrap_scope_fade={
"type": "float",
"value": 0.25
}
scrap_scope_funcs={
"type": "float",
"value": 1.0
}
scrap_scope_containers={
"type": "float",
"value": 1.0
}
scrap_text_mode={
"type": "float",
"value": 0.0
}
scrap_text_mono={
"type": "color",
"value": Color(0.322, 0.353, 0.392, 1)
}
scrap_roof_tone={
"type": "float",
"value": 0.06
}
scrap_bevel={
"type": "float",
"value": 0.06
}
scrap_light_dir={
"type": "vec3",
"value": Vector3(0.45, 0.8, 0.3)
}
scrap_light_strength={
"type": "float",
"value": 0.45
}
scrap_contact={
"type": "float",
"value": 0.45
}
scrap_flat={
"type": "float",
"value": 0.0
}

[rendering]

environment/defaults/default_clear_color=Color(0.086, 0.09, 0.106, 1)
anti_aliasing/quality/msaa_2d=0
textures/canvas_textures/default_texture_filter=1
