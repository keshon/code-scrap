; Engine configuration file.

config_version=5

[application]

config/name="code-scrap"
config/description="Zoomable map of a codebase — GDScript viewer"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://scripts/core/settings.gd"
Keymap="*res://scripts/core/keymap.gd"
Style="*res://scripts/core/style.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/energy_saving/keep_screen_on=false

[gui]

theme/default_font_antialiasing=1

[shader_globals]

scrap_glyph_from={
"type": "float",
"value": 4.0
}
scrap_glyph_full={
"type": "float",
"value": 8.0
}
scrap_text_weight={
"type": "float",
"value": 0.75
}

[rendering]

environment/defaults/default_clear_color=Color(0.086, 0.09, 0.106, 1)
anti_aliasing/quality/msaa_2d=0
textures/canvas_textures/default_texture_filter=1
